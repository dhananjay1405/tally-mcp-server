<ENVELOPE>
    <HEADER>
        <TALLYREQUEST>Import Data</TALLYREQUEST>
    </HEADER>
    <BODY>
        <IMPORTDATA>
            <REQUESTDESC>
                <REPORTNAME>Vouchers</REPORTNAME>
                <STATICVARIABLES>
                    {% if targetCompany %}
                    <SVCURRENTCOMPANY>{{targetCompany | escape}}</SVCURRENTCOMPANY>
                    {% endif %}
                </STATICVARIABLES>
            </REQUESTDESC>
            <REQUESTDATA>
                {% for voucher in vouchers %}
                <TALLYMESSAGE>
                    <VOUCHER VCHTYPE="{{ voucher.voucherType | escape }}" ACTION="Create" OBJVIEW="Accounting Voucher View">
                        <VOUCHERTYPENAME>{{ voucher.voucherType | escape }}</VOUCHERTYPENAME>
                        <DATE>{{ voucher.date | formatDate("yyyyMMdd") }}</DATE>
                        {% if voucher.narration != undefined and voucher.narration != "" %}
                        <NARRATION>{{ voucher.narration | escape }}</NARRATION>
                        {% endif %}
                        {% if voucher.voucherNumber != undefined %}
                        <VOUCHERNUMBER>{{ voucher.voucherNumber | escape }}</VOUCHERNUMBER>
                        {% endif %}
                        {% if voucher.isoptional === true %}
                        <ISOPTIONAL>Yes</ISOPTIONAL>
                        {% endif %}
                        {% for accountingLineItem in voucher.accountingEntry %}
                        <ALLLEDGERENTRIES.LIST>
                            <LEDGERNAME>{{ accountingLineItem.ledgerName | escape }}</LEDGERNAME>
                            <ISDEEMEDPOSITIVE>{{ "Yes" if accountingLineItem.amount < 0 else "No" }}</ISDEEMEDPOSITIVE>
                            <AMOUNT>{{accountingLineItem.amount }}</AMOUNT>
                            {% if accountingLineItem.bankAllocations != undefined %}
                            {% for bankAllocation in accountingLineItem.bankAllocations %}
                            <BANKALLOCATIONS.LIST>
                                {% if bankAllocation.instrumentDate !== undefined %}
                                <INSTRUMENTDATE>{{ bankAllocation.instrumentDate | formatDate("yyyyMMdd") }}</INSTRUMENTDATE>
                                {% else %}
                                <INSTRUMENTDATE>{{ voucher.date | formatDate("yyyyMMdd") }}</INSTRUMENTDATE>
                                {% endif %}
                                <TRANSACTIONTYPE>{{ bankAllocation.transactionType | escape }}</TRANSACTIONTYPE>
                                {% if bankAllocation.transactionType === "UPI" %}
                                <VIRTUALPAYMENTADDRESS>{{ bankAllocation.virtualPaymentAddress | escape }}</VIRTUALPAYMENTADDRESS>
                                {% endif %}
                                {% if bankAllocation.instrumentNumber !== undefined %}
                                <INSTRUMENTNUMBER>{{ bankAllocation.instrumentNumber | escape }}</INSTRUMENTNUMBER>
                                {% endif %}
                                {% if bankAllocation.bankName !== undefined %}
                                <BANKNAME>{{ bankAllocation.bankName | escape }}</BANKNAME>
                                {% endif %}
                                <AMOUNT>{{ bankAllocation.amount }}</AMOUNT>
                            </BANKALLOCATIONS.LIST>
                            {% endfor %}
                            {% endif %}
                        </ALLLEDGERENTRIES.LIST>
                        {% endfor %}
                    </VOUCHER>
                </TALLYMESSAGE>
                {% endfor %}
            </REQUESTDATA>
        </IMPORTDATA>
    </BODY>
</ENVELOPE>